---
import { ASSETS_BASE_URL } from "../config/assets";

const CAROUSEL_BASE = `${ASSETS_BASE_URL}/caroussel`;

const LOGOS = [
  "hero-gorbel.webp",
  "hero-lewis.webp",
  "hero-mecalux.webp",
  "hero-orbis.webp",
  "hero-presto.webp",
  "hero-quantum.webp",
  "hero-roach.webp",
  "hero-southworth.webp",
];
---

<section class="mt-6 overflow-hidden">
  <div class="relative w-full">
    <div class="logo-carousel-wrapper group">
      <div class="flex w-max gap-8 md:gap-12">
        {LOGOS.map((logo) => (
          <div class="logo-item shrink-0">
            <img
              src={`${CAROUSEL_BASE}/${logo}`}
              alt="Marca Indoff"
              class="h-8 md:h-12 w-auto object-contain"
              loading="lazy"
            />
          </div>
        ))}
        {LOGOS.map((logo) => (
          <div class="logo-item shrink-0" aria-hidden="true">
            <img
              src={`${CAROUSEL_BASE}/${logo}`}
              alt=""
              class="h-8 md:h-12 w-auto object-contain"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logo-carousel-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .logo-carousel-wrapper > div {
    animation: logo-scroll 25s linear infinite;
  }

  .logo-carousel-wrapper:hover > div {
    animation-play-state: paused;
  }

  .logo-item img {
    filter: grayscale(100%) opacity(0.6);
    transition: all 0.3s ease;
  }

  .logo-item:hover img {
    filter: grayscale(0%) opacity(1);
    transform: scale(1.05);
  }

  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel-wrapper > div { animation: none; }
  }
</style>