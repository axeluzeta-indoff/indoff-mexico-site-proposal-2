---
import { getAllBlogs } from "../data/blog/blog.repository";

const posts = getAllBlogs();
---

<section id="blog" data-animate="left" class="bg-white text-gray-900">
  <div class="mx-auto max-w-7xl px-6 py-20">

    <!-- Header -->
    <div class="mb-16 text-center">
      <h2 class="text-5xl font-extrabold tracking-tight text-[#169061]">
        Blog
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-700">
        Artículos técnicos, normativos y casos reales sobre seguridad,
        almacenamiento e ingeniería en manejo de materiales.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          aria-label={`Leer artículo: ${post.title}`}
          class="group flex flex-col overflow-hidden rounded-[28px] bg-[#f3f2ee]
                 shadow-sm transition
                 hover:-translate-y-1 hover:shadow-lg"
        >
          <!-- Imagen -->
          <div class="aspect-4/3 w-full overflow-hidden bg-gray-200">
            <img
              src={post.image}
              alt={post.title}
              class="h-full w-full object-cover transition-transform duration-300
                     group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Contenido -->
          <div class="flex flex-1 flex-col p-6">
            <!-- Meta -->
            <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-gray-600">
              <time datetime={post.publishedAt}>
                {new Date(post.publishedAt).toLocaleDateString("es-MX", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>

              <span class="text-gray-400">•</span>

              {post.tags.map((tag) => (
                <span
                  class="rounded-full bg-[#EEC028]/80 px-2 py-0.5
                         text-xs font-bold text-gray-900"
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- Título -->
            <h3
              class="text-xl font-extrabold leading-snug text-gray-900
                     transition-colors group-hover:text-[#169061]"
            >
              {post.title}
            </h3>

            <!-- Excerpt -->
            <p class="mt-3 flex-1 text-base leading-relaxed text-gray-700">
              {post.excerpt}
            </p>

            <!-- CTA visual -->
            <span
              class="mt-6 inline-flex items-center gap-2 font-extrabold
                     text-[#169061] transition group-hover:gap-3"
            >
              Leer artículo
              <span aria-hidden>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
