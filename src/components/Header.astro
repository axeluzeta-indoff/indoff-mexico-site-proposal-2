---
import { ASSETS_BASE_URL } from "../config/assets";

const underline =
  "absolute left-0 right-0 -bottom-1 mx-auto h-[3px] w-full rounded bg-[#EEC028] opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-[.active]:opacity-100";

const soluciones = [
  { name: "Estantería", href: "/soluciones/estanterias" },
  { name: "Grúas", href: "/soluciones/gruas" },
  { name: "Transportadores", href: "/soluciones/transportadores" },
  { name: "Mesas elevadoras", href: "/soluciones/mesas-elevadoras" },
  { name: "Contenedores", href: "/soluciones/contenedores" },
  { name: "Andenes", href: "/soluciones/andenes" },
  { name: "Integraciones", href: "/soluciones/integraciones" },
  { name: "Inspecciones", href: "/soluciones/inspecciones" },
];
---

<header class="sticky top-0 z-50 bg-[#169061] text-white">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center">
        <img
          src={`${ASSETS_BASE_URL}/brand/logo-indoff.webp`}
          alt="Indoff México"
          class="h-10 md:h-12 w-auto"
          loading="eager"
        />
      </a>

      <nav class="hidden items-center gap-7 lg:flex">
        <div class="relative group">
          <a href="#soluciones" class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white">
            Soluciones
            <span class={underline}></span>
          </a>
          <div class="absolute left-0 top-full h-4 w-48"></div>
          <div class="invisible absolute left-0 top-full z-50 mt-2 w-64 rounded-md bg-[#134c3a] py-3 opacity-0 shadow-xl transition-all duration-200 group-hover:visible group-hover:opacity-100">
            <ul class="flex flex-col text-sm">
              {soluciones.map(sol => (
                <li>
                  <a href={sol.href} class="block px-5 py-2 hover:bg-white/10 transition-colors">{sol.name}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <a
          href="/#catalogo"
          data-navlink
          class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white"
        >
          Catálogo
          <span class={underline}></span>
        </a>

        <a
          href="/#nosotros"
          data-navlink
          class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white"
        >
          Nosotros
          <span class={underline}></span>
        </a>

        <a
          href="/#casos-exito"
          data-navlink
          class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white"
        >
          Casos de éxito
          <span class={underline}></span>
        </a>

        <a
          href="/#blog"
          data-navlink
          class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white"
        >
          Blog
          <span class={underline}></span>
        </a>

        <a
          href="/#contacto"
          data-navlink
          class="group relative px-2 py-1 text-[15px] font-bold tracking-wide text-white/90 transition-colors hover:text-white"
        >
          Contacto
          <span class={underline}></span>
        </a>
      </nav>

      <button id="menu-btn" class="lg:hidden p-2" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-overlay" class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm transition-opacity"></div>

  <aside id="mobile-menu" class="fixed top-0 right-0 z-50 h-full w-[85%] max-w-87.5 translate-x-full transform bg-[#134c3a] shadow-2xl transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto">
    <div class="p-6">
      <div class="flex justify-end mb-6">
        <button id="close-btn" class="p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="flex flex-col gap-5">
        <div class="space-y-3">
          <p class="text-xs font-bold uppercase tracking-widest text-white/50">Soluciones</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            {soluciones.map(sol => (
              <a href={sol.href} class="mobile-link text-lg text-white/90">{sol.name}</a>
            ))}
          </div>
        </div>
        
        <hr class="border-white/10" />
        
        <a href="/#catalogo" class="mobile-link text-xl font-bold text-white">Catálogo</a>
        <a href="/#nosotros" class="mobile-link text-xl font-bold text-white">Nosotros</a>
        <a href="/#casos-exito" class="mobile-link text-xl font-bold text-white">Casos de éxito</a>
        <a href="/#blog" class="mobile-link text-xl font-bold text-white">Blog</a>
        <a href="/#contacto" class="mobile-link text-xl font-bold text-[#EEC028]">Contacto</a>
      </nav>
    </div>
  </aside>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const closeBtn = document.getElementById('close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('menu-overlay');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    mobileMenu?.classList.toggle('translate-x-full');
    overlay?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
</script>