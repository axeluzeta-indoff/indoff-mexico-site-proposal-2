---
import SolutionsGrid from "./SolutionsGrid.astro";
import LogoCarousel from "./LogoCarousel.astro";
---

<section id="soluciones" class="bg-white text-gray-900">
  <div class="mx-auto max-w-7xl px-6 py-10 md:py-20">
    
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[#169061] sm:text-4xl md:text-5xl">
        Nuestras Soluciones
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600 sm:text-xl">
        Optimiza tu operación con sistemas diseñados a la medida. 
        Aprovecha al máximo tu espacio y mejora la eficiencia de tu flujo logístico.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      
      <div class="order-1 lg:col-span-2">
        <SolutionsGrid />
      </div>

      <aside class="order-2 space-y-10">
        <div class="space-y-4 rounded-2xl bg-[#f3f2ee] p-6 lg:bg-transparent lg:p-0">
          <h3 class="text-xl font-extrabold text-gray-900 sm:text-2xl">
            Te apoyamos en:
          </h3>

          <ul class="space-y-3 text-base text-gray-900 sm:text-lg">
            <li class="flex items-start gap-3">
              <span class="mt-1 text-[#169061]">✓</span>
              <span>Apertura de plantas nuevas.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-[#169061]">✓</span>
              <span>Aumento de demanda.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-[#169061]">✓</span>
              <span>Proyectos de mejora continua.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-[#169061]">✓</span>
              <span>Evaluaciones de seguridad industrial.</span>
            </li>
          </ul>

          <a
            href="/#contacto" 
            class="mt-6 inline-flex w-full items-center justify-center rounded-md bg-[#169061] px-6 py-3 text-base font-extrabold text-white transition hover:bg-[#137e55] sm:text-lg"
          >
            Hablar con un experto
          </a>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl font-extrabold text-gray-900 sm:text-2xl">
            Representantes Autorizados
          </h3>
          <LogoCarousel />
        </div>
      </aside>
    </div>
  </div>
</section>