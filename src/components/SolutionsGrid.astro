---
import { SOLUTIONS } from "../data/solutions";
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
  {SOLUTIONS.map((item) => (
    <a
      href={`/soluciones/${item.slug}`}
      class="group block rounded-[28px] bg-[#d9d7cf] p-4 shadow-sm transition hover:bg-[#169061] hover:-translate-y-1 hover:shadow-lg"
    >
      <div class="overflow-hidden rounded-[22px] bg-gray-200">
        <div class="aspect-4/3 w-full">
          <img
            src={item.heroImg}
            alt={item.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </div>

      <div class="pt-3 text-center transition-colors group-hover:text-white">
        <h3 class="flex items-center justify-center min-h-12 text-base font-extrabold leading-tight px-2">
          {item.title}
        </h3>

        <span class="mt-1 inline-block text-sm font-medium underline underline-offset-4 decoration-current opacity-90">
          Ver más
        </span>
      </div>
    </a>
  ))}
</div>